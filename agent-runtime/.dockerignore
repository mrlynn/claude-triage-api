# The Dockerfile runs `npm ci` and THEN `COPY . .`, so anything matched here is
# what stops the copy from clobbering the install it just did.
#
# node_modules is the one that matters. The Agent SDK resolves a per-platform
# binary — @anthropic-ai/claude-agent-sdk-darwin-arm64 on a Mac, linux-x64 in
# the image — so copying a developer's tree into the build would put a Darwin
# executable inside a Linux container and fail at spawn time, long after the
# build reported success. It is also 314MB of pointless layer.
node_modules
dist

# Never bake a credential into an image layer.
.env
.env.local
