# Required. The storefront calls Claude server-side; this never reaches the browser.
ANTHROPIC_API_KEY=sk-ant-...

# MongoDB Atlas, used for rate limiting and the daily spend cap.
# Provisioned by `vercel integration add mongodbatlas`, or point it at any
# cluster you already have. Without it the support form refuses live
# submissions in production rather than running uncapped.
MONGODB_URI=mongodb+srv://...
MONGODB_DB=northwind_support

# Ceilings on live triage calls. Per-IP windows are scoped per surface so the
# injection playground cannot starve the support form; the daily cap is global
# because the bill does not care which page spent it.
SUPPORT_IP_LIMIT=5
INJECTION_IP_LIMIT=8
# The as-you-type preview on /playground/live. Higher than the other paid
# surfaces because ONE message legitimately costs several calls — the debounce
# fires whenever the writer pauses. What makes that safe is the model, not the
# count: a Haiku preview against a cached prefix is roughly a fiftieth of a
# triage call.
LIVE_IP_LIMIT=40
# Queue reads and token attempts. Higher because refreshing the board during a
# session is normal traffic; the point is a floor under brute force, not a
# tight budget.
QUEUE_IP_LIMIT=60
SUPPORT_DAILY_CAP=600

# Which model the support form calls. Defaults to claude-opus-5.
# Must have a row in MODEL_CATALOG (src/config.ts) or cost accounting throws
# rather than silently guessing flagship rates.
TRIAGE_MODEL=claude-opus-5

# Which model runs the as-you-type preview. The cheaper tier: it runs many
# times per message and it is a hint, not a verdict. Same MODEL_CATALOG
# requirement as TRIAGE_MODEL.
LIVE_MODEL=claude-sonnet-5

# The Tutor (/tutor on the course site). Plans, lessons and attempt reviews.
# A balanced model: it writes teaching material and grades it, and the course
# corpus is a cached prefix, so most of each call is billed at cache-read
# rates. Same MODEL_CATALOG requirement as TRIAGE_MODEL.
TUTOR_MODEL=claude-sonnet-5
# Per-IP window for Tutor calls. A session is about four calls.
TUTOR_IP_LIMIT=20

# Shared token gating /queue AND the live section of /ops. Queue depth and
# model spend are real figures from a real account; the simulated operating
# history on /ops stays public, because it is invented and it is the teaching
# artifact six places in the course link to.
# UNSET MEANS DISABLED, never open — a missing secret must not read as
# "no check required". This is demo access control, not authentication:
# no user model, no per-reviewer identity, no audit trail.
QUEUE_TOKEN=pick-something-long

# Ask Northwind needs no configuration of its own. It runs in this app, on the
# same ANTHROPIC_API_KEY and MONGODB_URI above; the course site reaches it
# through the CORS-protected /api/assistant/* routes.

# ---- Who pays for a call: free credit and bring-your-own-key (docs/byok) ----
#
# off      the owner's key pays for everything, under the limits above. The
#          default, and forced whenever GITHUB_CLIENT_ID/SECRET are unset, so
#          local development needs none of this.
# shadow   sign-in and the meter run and spend is recorded, but nobody is
#          refused for credit. Run this for a week and read usage_daily before
#          enforcing.
# enforce  anonymous visitors are asked to sign in; a learner whose credit is
#          spent is asked for their own Anthropic key. SUPPORT_DAILY_CAP stops
#          applying and HOUSE_DAILY_BUDGET_USD takes over.
BYOK_MODE=off

# A GitHub OAuth app. Callback URL: https://<storefront host>/api/auth/github/callback
# No scopes are requested. Use a second app for localhost:3002.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Seals learners' API keys (AES-256-GCM) and the sign-in state cookie.
# Generate with: openssl rand -base64 32
# To rotate: move the old value to _PREVIOUS and set a new one. Keys sealed
# under a master key that is in neither slot are deleted and re-entered.
BYOK_ENCRYPTION_KEY=
BYOK_ENCRYPTION_KEY_PREVIOUS=

# Free credit per GitHub account, in dollars, decided once at first sign-in.
TRIAL_GRANT_USD=2
# Accounts younger than this get no free credit, only the bring-your-own-key path.
TRIAL_MIN_ACCOUNT_AGE_DAYS=30
# New grants per UTC day. Past it, new accounts get no free credit until tomorrow.
TRIAL_GRANTS_DAILY=200
# The most the owner's key spends on free credit per UTC day, across everyone.
# Set an organization-level spend limit in the Anthropic Console as well (there
# is no per-workspace cap; see docs/facilitator/keys.md). This is the
# application's ceiling; the Console's is the one that holds if the app has a bug.
HOUSE_DAILY_BUDGET_USD=50
# Signed-in learners get this many times the per-IP windows above. A workshop
# room is thirty people behind one IP address.
SIGNED_IN_IP_MULTIPLIER=3
# Attempts to add an API key, per IP per 10 minutes. Each one asks Anthropic
# whether a key is valid, so this is what stops the route being an oracle.
KEY_IP_LIMIT=10

# ---- Platform admin console (/admin, Decision 13) ----
#
# Numeric GitHub ids, comma-separated, never logins. Find yours with
#   curl -s https://api.github.com/users/<login> | jq .id
# Unset means nobody: /admin is a 404 for everyone. Sign in first at
#   /api/auth/github/start?returnTo=/admin
# which needs BYOK_MODE=shadow or enforce.
ADMIN_GITHUB_IDS=
