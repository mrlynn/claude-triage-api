# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PORT=8787
TRIAGE_MODEL=claude-opus-5

# Local Agent SDK runtime, launched by `npm run dev:all` on port 8790.
# Override this before deployment; the dev default is only for localhost.
ASSISTANT_RUNTIME_TOKEN=replace-with-a-long-random-secret
