# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PORT=8787
TRIAGE_MODEL=claude-opus-5

# Set to "off" to skip the boot-time cache-prefix check. That check is one free
# countTokens call and it warns when the configured model will not cache the
# prefix — worth keeping on unless you are developing offline.
PREFLIGHT=on
