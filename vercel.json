{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix website",
  "buildCommand": "cd website && npm run build",
  "outputDirectory": "website/build",
  "ignoreCommand": "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && bash website/scripts/vercel-ignore.sh'",
  "github": {
    "silent": true
  },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/video/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=2592000"
      },
      "continue": true
    },
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "^/(?:(.*)/)?index(?:\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/(.+)/$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
